# architect-run limits. Read by run.sh and preflight.sh on every run.
# Changing a number here changes behaviour; tests/test_v01.py proves it.
TASK_USD=8
TASK_HALT_PCT=90
MONTH_USD=40
MONTH_HALT_PCT=90
ROUNDS=2
DIFF_MAX_LINES=400
DIFF_MAX_FILES=8
NEIGHBOR_MAX_FILES=8
NEIGHBOR_MAX_KB=80
WALL_CLOCK_S=1500
# Provider-side spend caps. A number on a USD line means "the console enforces
# this", so a line stays empty unless a real console cap exists. A pretend number
# is worse than a blank, and preflight --model refuses it.
#   xAI IS_REAL no     there is no console cap: the USD line stays empty and the in-code
#                      xAI halt (MONTH_HALT_PCT of XAI_MONTH_USD) is the only stop.
#   xAI IS_REAL yes    the USD line holds the real cap, and XAI_MONTH_USD may not exceed it.
#   Anthropic IS_REAL  yes means Jeremy has set that monthly limit on workspace
#                      architect-builder in the Anthropic console. keys/anthropic may
#                      exist only then. It is a parked key: nothing here calls Anthropic.
CONSOLE_CAP_ANTHROPIC_USD=40
CONSOLE_CAP_ANTHROPIC_IS_REAL=yes
CONSOLE_CAP_XAI_USD=
CONSOLE_CAP_XAI_IS_REAL=no
# In-code Anthropic budget. 0 means no builder call is authorized. Only a ruling raises it.
# Raised to 2 on Nov 21 by Grok's ruling: exactly one R3 run, because one hold fills the month.
ANTHROPIC_MONTH_USD=2
# --- R2 spec round (one reviewer call to api.x.ai) ---
R2_TASK_USD=2
XAI_MONTH_USD=15
XAI_IN_PER_M=2
XAI_CACHED_IN_PER_M=0.50
XAI_OUT_PER_M=6
R2_MAX_OUTPUT_TOKENS=16000
R2_MAX_SPEC_KB=200
# --- R3 one caged run (one builder call to api.anthropic.com) ---
# R3_TASK_USD is the cap on one run and the size of its hold. It is not a budget:
# no live call starts while ANTHROPIC_MONTH_USD above is 0. There is no percentage
# line for Anthropic: a run starts only if spent plus one task cap fits the month.
# Prices are claude-haiku-5-5 list prices per million tokens, prompts up to 100K.
R3_TASK_USD=2
# R3_HOLD_USD is what one live run reserves before the call. It must cover the worst case
# the code computes for that call and may not exceed the task cap. R3_LIVE_MAX is how many
# live R3 calls may be started in one calendar month, counted in the ledger.
R3_HOLD_USD=0.001
# The three-file task shape (three named files, 120 lines in all, max_tokens 4096) reserves
# this instead. The code refuses a value above 0.005, and refuses the run if the worst
# case it computes is higher than the hold.
R3_HOLD_THREE_USD=0.005
R3_LIVE_MAX=5
ANTHROPIC_IN_PER_M=0.10
ANTHROPIC_OUT_PER_M=0.50
ANTHROPIC_CACHE_WRITE_PER_M=0.20
ANTHROPIC_CACHE_READ_PER_M=0.01
