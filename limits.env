# architect-run limits. Read by run.sh and preflight.sh on every run.
# Changing a number here changes behaviour; tests/test_v01.py proves it.
TASK_USD=8
TASK_HALT_PCT=90
MONTH_USD=40
MONTH_HALT_PCT=90
ROUNDS=2
DIFF_MAX_LINES=400
DIFF_MAX_FILES=8
NEIGHBOR_MAX_FILES=8
NEIGHBOR_MAX_KB=80
WALL_CLOCK_S=1500
# Provider-side spend caps. A number on a USD line means "the console enforces
# this", so both stay empty unless a real console cap exists. A pretend number
# is worse than a blank, and preflight --model refuses it.
#   IS_REAL no   there is no console cap: both USD lines stay empty and the in-code
#                xAI halt (MONTH_HALT_PCT of XAI_MONTH_USD) is the only stop.
#   IS_REAL yes  the xAI USD line holds the real cap, and XAI_MONTH_USD may not exceed it.
# The Anthropic line stays empty either way: nothing here calls Anthropic.
CONSOLE_CAP_ANTHROPIC_USD=
CONSOLE_CAP_XAI_USD=
CONSOLE_CAP_XAI_IS_REAL=no
# --- R2 spec round (one reviewer call to api.x.ai) ---
R2_TASK_USD=2
XAI_MONTH_USD=15
XAI_IN_PER_M=2
XAI_CACHED_IN_PER_M=0.50
XAI_OUT_PER_M=6
R2_MAX_OUTPUT_TOKENS=16000
R2_MAX_SPEC_KB=200
